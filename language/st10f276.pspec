<?xml version="1.0" encoding="UTF-8"?>

<!-- SPEC revision from Claude AI

 See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/processor_spec.rxg -->

<!--
    ST10F276E processor spec - REBUILT X-Bus peripheral section.

    The default_symbols in the previous version of this file for the
    0xE800-0xEFFF window (CAN1/CAN2/I2C/XSSC/XASC/XPWM/XMISC) used an
    old/generic CAN2000-style register template (CxCSR/CxIR/CxBTR/CxGMS +
    CxMCR/CxAR/CxLAR/CxMCFG per message object) with base addresses that
    were also inconsistent with a sibling c167cs.pspec (CAN1/CAN2 swapped).

    This version replaces that whole block with the actual register names
    and offsets from the ST10F276E datasheet (STMicroelectronics Doc ID
    12303 Rev 4), Table 69 "X-Registers ordered by name" and Table 70
    "X-registers ordered by address" - verified by rendering the datasheet
    pages directly (not by plain text extraction, which garbles multi-
    column tables), and cross-checked against observed firmware behavior:
    the target ROM writes a *variable* object index into EF10
    (CAN1IF1CR) in a busy-poll retry loop, which only makes sense for the
    Bosch C_CAN shared-interface-window architecture used here - not the
    old per-object-register model the previous file assumed.

    NOT independently re-verified in this pass: the ESFR/SFR core-CPU
    register block (0xF000-0xFFFF: timers, ports, DPP/CSP, interrupt
    control, etc.) is carried over from the previous file essentially
    unchanged, since nothing so far contradicted it. Two things worth a
    second look later:
      - RTCL/RTCH at 0xF0D4/0xF0D6 (ESFR) duplicate the real, datasheet-
        confirmed RTC peripheral at 0xED00-0xED14 (XBUS). Possibly a
        leftover from an older chip variant where RTC lived in ESFR -
        left in place but flagged, not deleted, since it wasn't
        contradicted by any firmware behavior we've looked at yet.
      - Fixed two malformed addresses in the original file (S0TBUF/
        S0RBUF/S0BG were missing the "0x" prefix - "ram:0FEB0" instead
        of "ram:0xFEB0" - which would fail to parse or silently break).

    If you determine your actual chip (ST10F275CEG) differs from
    ST10F276E in its X-Bus map, re-derive this block from that chip's
    own datasheet Table 69/70 the same way.
-->

<processor_spec>

    <properties>
        <property key="addressesDoNotAppearDirectlyInCode" value="true"/>
        <property key="pcodeInjectLibraryClass" value="ghidrainfineon.PcodeInject"/>
    </properties>

    <programcounter register="IP"/>
    <data_space space="ram"/>

    <!-- C166 segment operation: base is DPP page value, inner is offset -->
    <!-- Final address = (base << 14) | inner -->
    <!-- For indirect access: segment(0, reg) just zero-extends -->
    <!-- For switches: SwitchLoad masks inner to 14 bits before calling -->
    <segmentop space="ram" userop="segment" farpointer="no">
        <pcode>
            <input name="base" size="2"/>
            <input name="inner" size="2"/>
            <output name="res" size="3"/>
            <body><![CDATA[
                res = (zext(base) << 14) | zext(inner);
            ]]></body>
        </pcode>
        <constresolve>
            <register name="DPP0"/>
        </constresolve>
    </segmentop>

    <register_data>
        <register name="contextreg" hidden="true"/>
        <register name="Counter" hidden="true"/>
        <register name="ExtrEn" hidden="true"/>
        <register name="ExtpEn" hidden="true"/>
        <register name="ExtsEn" hidden="true"/>
        <register name="Extp" hidden="true"/>
        <register name="Exts" hidden="true"/>
    </register_data>

    <default_symbols>

        <!-- ================================================================
             XSSC (0xE800-0xE9FF) - confirmed: Table 69/70
             ================================================================ -->
        <symbol name="XSSCCON" address="ram:0xE800" size="2"/>
        <symbol name="XSSCCONSET" address="ram:0xE802" size="2"/>
        <symbol name="XSSCCONCLR" address="ram:0xE804" size="2"/>
        <symbol name="XSSCTB" address="ram:0xE806" size="2"/>
        <symbol name="XSSCRB" address="ram:0xE808" size="2"/>
